# --- P0 demo readiness: artefactos que se seguian versionando sin valor ---
# legacy/ y docs/legacy/: la app Next.js anterior. No es paquete del workspace
# (pnpm-workspace.yaml solo lista src-astro), no tiene
# package.json ni tsconfig, y ningun build/CI la referencia: 234 archivos y
# 1.8 MB (incluido docs/legacy/firebase-debug.log, 1.0 MB) que nadie ejecuta.
# Untrackeado, no borrado: sigue en disco y en el historial de git.
legacy/
docs/legacy/

# .hermes/ entero: briefs internos de delegacion de agentes (57 archivos, 356 KB)
# en un repo que ve el cliente. .atl/: cache del skill-registry con rutas absolutas
# del skill-registry local — paths de esta maquina, sin uso fuera de ella.
.hermes/
.atl/

# --- Artefactos generados en cada refresh de skills/docs (2026-10-27) ---
# .gitcore/skill-registry.json: copia para GitCore de .atl/skill-registry.md, la escribe
# ~/.hermes/scripts/skill-registry-refresh.sh en cada maquina. Nada la consume fuera de
# ella y cambia en cada refresh (rutas absolutas, timestamps) => churn sin valor.
.gitcore/skill-registry.json
# docs/SWAL/: NEW_SCOPES_*.md que escribe swal-docs-propagate.sh desde la plantilla
# interna + SRS. Se regenera, no se edita a mano. Ignorado, no borrado:
# los dos siguen en disco. Ver docs/REVISION-2026-10-27.md (§ Repo hygiene).
docs/SWAL/

# .vscode/ ya estaba ignorado en la linea 46; vercel.json se declaraba como
# "pendiente" en un plan interno (F5_VERCEL_SWITCH_PREP), pero el producto despliega
# a Cloudflare Workers con wrangler deploy (ver private/infra/workflows/deploy-astro.yml). El archivo ya apuntaba a Astro (src-astro/dist), o
# sea que la migracion F5 quedo a medias en su doc, no en el archivo.
vercel.json

# --- Split publico/privado (refactor/public-split) ---
# Config real de wrangler: ids de la cuenta de Cloudflare (D1, KV). Se copia en el deploy desde el repo
# privado de infraestructura (private/infra/scripts/overlay-cloud.sh). Plantilla: src-astro/wrangler.example.jsonc.
/src-astro/wrangler.toml
/src-astro/wrangler.jsonc
/src-astro/wrangler.json
# Estado local de wrangler/miniflare: nunca se versiona.
.wrangler/
