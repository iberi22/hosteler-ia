#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running pre-merge validation..."
echo ""

echo "📦 1/3 | Lint..."
npm run lint
if [ $? -ne 0 ]; then exit 1; fi

echo "🧪 2/3 | Unit Tests..."
npm run test:ci
if [ $? -ne 0 ]; then exit 1; fi

echo "🏗️  3/3 | Build..."
npm run build
if [ $? -ne 0 ]; then exit 1; fi

echo "🎉 All validations passed!"
