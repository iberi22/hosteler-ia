---
// Carta publica por slug: fize.swal.network/{tienda}/menu
//
// Es la URL que se imprime en el QR de la mesa y la que el cliente final abre.
// No pide sesion. Solo expone platos publicos: las recetas no se consultan
// aqui (ver src/lib/publicMenuBySlug.ts).
//
// Primero la carta PUBLICADA (instantanea firmada de un nodo local, R2 `public/menu/<slug>.json`, Cache
// API 60 s); si no hay, la de la nube como siempre. `?mesa=N` (QR de la mesa) va en el mensaje de WhatsApp.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicMenu from '../../components/menu/PublicMenu.svelte';
import { createStorageAdapter } from '../../lib/storageAdapter';
import { domainConfig } from '../../lib/domain.config';
import { loadMenuBySlug } from '../../lib/publicMenuBySlug';
import { loadMenuForPublicPage, sanitizeMesa } from '../../lib/publicMenuSnapshot';
import { publicMenuUnavailableHtml } from '../../lib/publicMenuUnavailable';
import { getWorkerBindings, getWorkerCache } from '../../lib/workerBindings';

const { slug } = Astro.params;
const instanceId = Astro.url.searchParams.get('instance_id') ?? domainConfig.instanceId ?? 'default';

if (!slug) {
  return Astro.redirect('/');
}

const env = await getWorkerBindings();
const loaded = await loadMenuForPublicPage({
  slug,
  r2: env?.SWAL_R2,
  origin: Astro.url.origin,
  cache: getWorkerCache(),
  loadFromAdapter: () => loadMenuBySlug(createStorageAdapter(Astro.locals), instanceId, slug),
});
const menu = loaded?.menu ?? null;
const mesa = sanitizeMesa(Astro.url.searchParams.get('mesa'));

// La carta que no existe sigue siendo un 404, pero con el aviso amable que /local/publicar le
// promete al duenno («Esta carta todavía no está publicada», QA pre-entrega 2026-10-13 #5).
// El estado se fija aqui y el cuerpo se elige en la plantilla: un `return` dentro del `if`
// hacia que `astro check` no contara la referencia a `publicMenuUnavailableHtml` (import marcado
// como no usado). Con SSR el estado de `Astro.response` es el que viaja al comensal.
const faltaCarta = !menu;
if (faltaCarta) Astro.response.status = 404;

const fromCloud = loaded?.source === 'cloud';
const base = import.meta.env.PUBLIC_BASE_URL?.replace(/\/$/, '') ?? Astro.url.origin;
---

{menu ? (
  <BaseLayout
    title={`${menu.restaurant.name} — Carta`}
    currentPath={`/${menu.restaurant.slug || slug}/menu`}
    showNav={false}
  >
    <PublicMenu
      client:load
      instanceId={instanceId}
      restaurantId={menu.restaurant.id}
      restaurantName={menu.restaurant.name}
      categories={menu.categories}
      items={menu.items}
      storeSlug={menu.restaurant.slug || slug}
      restaurantPhone={menu.restaurant.phone ?? ''}
      baseUrl={base}
      tableLabel={mesa}
      loadNutrition={fromCloud}
    />
  </BaseLayout>
) : (
  <Fragment set:html={publicMenuUnavailableHtml(slug)} />
)}
