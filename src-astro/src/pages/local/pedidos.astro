---
import { Button, Card } from "@swal/ui";
import KitchenQueue from "../../components/orders/KitchenQueue.svelte";

export const prerender = true;
import LocalLayout from "../../layouts/LocalLayout.astro";
import { ORDER_STATUSES, ORDER_STATUS_LABELS } from "../../lib/orderStateMachine";
import { PEDIDOS_FILTER_SCRIPT } from "../../lib/inlineScripts";

// La pagina se prerenderiza: `Astro.url.searchParams` siempre esta vacio en el HTML generado,
// asi que el filtro NO puede resolverse aqui (QA pre-entrega 2026-10-13 #6: con `?status=paid`
// el chip activo seguia siendo "Todos"). La pagina pasa todos los carriles y el chip lo marca
// el script inline; KitchenQueue ya relee `?status=` en el cliente para elegir los carriles.
const laneStatuses = [...ORDER_STATUSES];
---

<LocalLayout title="Pedidos — Fi'ze Dashboard (Local)">
  <main class="orders-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/local/">← Inicio</a>
      <span>/</span>
      <span>Pedidos</span>
    </nav>

    <header class="orders-header">
      <div>
        <h1>Pedidos</h1>
        <p class="sub">Listado de pedidos en tiempo real — Local</p>
      </div>
      <Button variant="primary" href="/local/nuevo-pedido/">Nuevo pedido</Button>
    </header>

    <Card variant="surface" padding="md">
      <p class="hint">
        Visualización completa de pedidos en cocina. Para entrar al KDS interactivo, abre
        <a href="/local/cocina/">Cocina</a>.
      </p>

      <div class="filter-section">
        <span class="filter-label">Filtrar por estado:</span>
        <div class="chips-container" role="navigation" aria-label="Filtro de estado de pedidos">
          <a href="/local/pedidos/" class="chip" data-pedidos-chip="" aria-pressed="false">
            Todos
          </a>
          {ORDER_STATUSES.map((status) => (
            <a
              href={`/local/pedidos/?status=${status}`}
              class="chip"
              data-pedidos-chip={status}
              aria-pressed="false"
            >
              {ORDER_STATUS_LABELS[status]}
            </a>
          ))}
        </div>
      </div>
    </Card>

    <KitchenQueue client:load autoPublish={false} statuses={laneStatuses} />

    <!-- Marca el chip activo en el cliente (QA #6): al ir despues de los chips, ya existen en el DOM. -->
    <script is:inline set:html={PEDIDOS_FILTER_SCRIPT} />
  </main>
</LocalLayout>

<style>
  .orders-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--swal-text-muted);
    font-size: 0.85rem;
  }
  .crumbs a {
    color: var(--swal-accent-cyan);
    text-decoration: none;
  }
  .crumbs a:hover { text-decoration: underline; }
  .orders-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .orders-header h1 {
    margin: 0;
    color: var(--swal-text);
    font-size: 1.6rem;
  }
  .sub {
    color: var(--swal-text-secondary);
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }
  .hint { color: var(--swal-text-secondary); margin: 0 0 0.75rem; font-size: 0.9rem; }
  .filter-section {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .filter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--swal-text);
  }
  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--swal-text-secondary);
    background: var(--swal-bg-elevated);
    border: 1px solid var(--swal-border);
    transition: all 0.15s ease-in-out;
  }
  .chip:hover {
    color: var(--swal-text);
    border-color: var(--swal-accent-cyan);
  }
  .chip.active {
    background: var(--swal-accent-cyan);
    color: #000;
    border-color: var(--swal-accent-cyan);
    font-weight: 700;
  }
</style>
