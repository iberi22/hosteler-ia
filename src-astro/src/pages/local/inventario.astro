---
export const prerender = true;
import LocalLayout from "../../layouts/LocalLayout.astro";
import InventoryStats from "../../components/inventory/InventoryStats.svelte";
import StockAlerts from "../../components/inventory/StockAlerts.svelte";
import InventoryManager from "../../components/inventory/InventoryManager.svelte";
---

<LocalLayout title="Inventario — Fi'ze Dashboard (Local)">
  <main class="inventory-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/local/">← Inicio</a>
      <span>/</span>
      <span>Inventario</span>
    </nav>

    <header class="page-header">
      <h1 class="page-title">Inventario</h1>
    </header>

    <InventoryStats client:only="svelte" />

    <div class="inventory-grid">
      <div class="grid-main">
        <StockAlerts client:only="svelte" />
      </div>
    </div>

    <InventoryManager client:load />
  </main>
</LocalLayout>

<script>
  import { refreshInventoryFromApi } from '../../stores/inventory.svelte';
  refreshInventoryFromApi();
</script>

<style>
  .inventory-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--swal-text-muted);
    font-size: 0.85rem;
  }
  .crumbs a {
    color: var(--swal-accent-cyan);
    text-decoration: none;
  }
  .crumbs a:hover { text-decoration: underline; }
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--swal-text, #e2e8f0);
    margin: 0;
  }
  .inventory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
</style>
