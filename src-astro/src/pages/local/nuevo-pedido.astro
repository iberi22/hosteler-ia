---
import TakeOrderForm from "../../components/orders/TakeOrderForm.svelte";
import LocalLayout from "../../layouts/LocalLayout.astro";

export const prerender = true;
---
<LocalLayout title="Nuevo pedido — Fi'ze (Local)">
  <main class="take-order-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/local/">← Inicio</a>
      <span>/</span>
      <span>Nuevo pedido</span>
    </nav>

    <header>
      <h1>Nuevo pedido</h1>
      <p class="sub">Arma el pedido de la mesa: elige los platos y confirma. Funciona sin internet.</p>
    </header>

    <TakeOrderForm client:load />
  </main>
</LocalLayout>

<style>
  .take-order-page {
    display: flex; flex-direction: column; gap: 1.25rem;
    max-width: 720px; margin: 0 auto; padding: 2rem 1rem;
  }
  .crumbs { display: flex; gap: 0.5rem; color: var(--swal-text-muted); font-size: 0.85rem; }
  .crumbs a { color: var(--swal-accent-cyan); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  h1 { margin: 0; color: var(--swal-text); font-size: 1.6rem; }
  .sub { color: var(--swal-text-secondary); margin: 0.25rem 0 0; font-size: 0.95rem; }
</style>
