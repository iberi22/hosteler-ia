---
export const prerender = true;
import LocalLayout from "../../layouts/LocalLayout.astro";
import RecipeManager from "../../components/recipes/RecipeManager.svelte";
import GosRecetarioImport from "../../components/recipes/GosRecetarioImport.svelte";
---

<LocalLayout title="Recetas — Fi'ze Dashboard (Local)">
  <main class="recipes-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/local/">← Inicio</a>
      <span>/</span>
      <span>Recetas</span>
    </nav>

    <header class="page-header">
      <h1 class="page-title">Recetas</h1>
      <p class="sub">
        Privadas por defecto. El cliente ve el plato, nunca los ingredientes ni el modo de preparacion.
      </p>
    </header>

    <GosRecetarioImport client:load />
    <RecipeManager client:load />
  </main>
</LocalLayout>

<style>
  .recipes-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--swal-text-muted);
    font-size: 0.85rem;
  }
  .crumbs a {
    color: var(--swal-accent-cyan);
    text-decoration: none;
  }
  .crumbs a:hover { text-decoration: underline; }
  .page-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--swal-text, #e2e8f0);
    margin: 0;
  }
  .sub { margin: 0.25rem 0 0; font-size: 0.85rem; max-width: 42rem; color: var(--swal-text-secondary); }
</style>
