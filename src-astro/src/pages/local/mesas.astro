---
import TableMap from "../../components/tables/TableMap.svelte";
import LocalLayout from "../../layouts/LocalLayout.astro";

export const prerender = true;
---
<LocalLayout title="Fi'ze — Mesas (Local)">
  <div class="page">
    <h1 class="title">Mesas</h1>
    <p class="sub">Gestión de mesas y códigos QR de pedido</p>
    <!-- El dashboard (`/dashboard/tables`) conserva la hoja imprimible con sesion; en modo local se
         pasa `/local/publicar/`: `/dashboard/tables/print` pide sesion y termina en /login (#2). -->
    <TableMap client:load newOrderBase="/local/nuevo-pedido/" printHref="/local/publicar/" printLabel="Ver QR para imprimir" />
  </div>
</LocalLayout>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; display: grid; gap: 1rem; }
  .title { font-size: 1.5rem; font-weight: 800; color: var(--swal-text); }
  .sub { color: var(--swal-text-secondary); }
</style>
