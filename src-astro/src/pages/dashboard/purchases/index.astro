---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PurchaseManager from '../../../components/purchases/PurchaseManager.svelte';
---

<BaseLayout showNav title="Compras — Fi'ze" currentPath="/dashboard/purchases">
  <div class="page">
    <header class="head">
      <h1>Compras e insumos</h1>
      <p class="sub">
        Facturas de proveedor. Cada compra suma stock y actualiza el costo de los insumos,
        que es lo que despues calcula el costo real de cada receta.
      </p>
    </header>
    <PurchaseManager client:load />
  </div>
</BaseLayout>

<style>
  .page { display: flex; flex-direction: column; gap: 1rem; }
  .head h1 { margin: 0; font-size: 1.3rem; }
  .sub { margin: 0; font-size: 0.85rem; opacity: 0.65; max-width: 46rem; }
</style>
