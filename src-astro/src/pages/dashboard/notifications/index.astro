---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotificationCenter from '../../../components/notifications/NotificationCenter.svelte';
import { Card } from '@swal/ui';

const apiEndpointUrl = `${Astro.url.origin}/api/notifications`;
---

<BaseLayout title="Avisos — Fi'ze Dashboard">
  <main class="notifications-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/dashboard/orders">← Inicio</a>
      <span>/</span>
      <span>Avisos</span>
    </nav>

    <header class="page-header">
      <div>
        <h1>Avisos</h1>
        <p class="sub">Lo que el restaurante tiene que saber: bajo stock, cobros, errores del sistema.</p>
      </div>
    </header>

    <NotificationCenter client:load />

    <Card variant="elevated" padding="md">
      <h2>API de Avisos</h2>
      <p class="hint">
        Endpoint REST. Filtra por <code>isRead</code>, <code>type</code>, <code>priority</code>,
        <code>page</code> y <code>limit</code>. Cada aviso ajeno a tu sesion responde 404.
      </p>
      <pre class="endpoint"><code>GET {apiEndpointUrl}</code></pre>
    </Card>
  </main>
</BaseLayout>

<style>
  .notifications-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--swal-text-muted, #64748b);
    font-size: 0.85rem;
  }
  .crumbs a { color: var(--swal-accent-cyan, #22d3ee); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .page-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 0.85rem; }
  .page-header h1 { margin: 0; color: var(--swal-text, #e2e8f0); font-size: 1.6rem; }
  .sub { color: var(--swal-text-secondary, #94a3b8); margin: 0.25rem 0 0; font-size: 0.95rem; }

  .hint { color: var(--swal-text-secondary, #94a3b8); margin: 0 0 0.75rem; font-size: 0.9rem; }
  .hint code {
    background: var(--swal-bg-elevated, rgba(255,255,255,0.04));
    border-radius: 3px;
    padding: 0 0.25rem;
  }

  h2 { color: var(--swal-text, #e2e8f0); margin: 0 0 0.5rem; font-size: 1.05rem; }

  .endpoint {
    background: var(--swal-bg-elevated, rgba(255,255,255,0.04));
    border: 1px solid var(--swal-border, rgba(255,255,255,0.08));
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    color: var(--swal-accent-cyan, #22d3ee);
    font-family: var(--swal-font-mono, monospace);
    font-size: 0.85rem;
    margin: 0;
    overflow-x: auto;
  }
</style>