---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeManager from '../../../components/recipes/RecipeManager.svelte';
---

<BaseLayout showNav title="Recetas — Fi'ze" currentPath="/dashboard/recipes">
  <main>
    <div class="page">
      <header class="head">
        <h1>Recetas</h1>
        <p class="sub">
          Privadas por defecto. El cliente ve el plato, nunca los ingredientes ni el modo de preparacion.
        </p>
      </header>
      <RecipeManager client:load />
    </div>
  </main>
</BaseLayout>

<style>
  .page { display: flex; flex-direction: column; gap: 1rem; }
  .head h1 { margin: 0; font-size: 1.3rem; }
  .sub { margin: 0; font-size: 0.85rem; color: var(--swal-text-secondary); max-width: 42rem; }
</style>
