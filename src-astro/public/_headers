# Paginas estaticas (prerenderizadas): sin analitica inyectada por Cloudflare (ver src/lib/noTransform.ts).
# Mantener el revalidado por defecto de los assets HTML: sin max-age el navegador cachearia a ojo.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/offline/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
# Modo local (docs/producto/NODO-LOCAL.md §2.1): estaticas sin middleware, asi que las cabeceras de seguridad
# que pone src/middleware.ts no llegan; se fijan aqui. `/local` sin barra redirige a `/local/`.
/local
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
/local/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
